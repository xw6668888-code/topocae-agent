{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topocae.local/schemas/cae_intent_result.schema.json",
  "title": "TopoCAE CAE Intent Result v1",
  "oneOf": [
    {
      "$ref": "#/$defs/validResult"
    },
    {
      "$ref": "#/$defs/clarificationResult"
    },
    {
      "$ref": "#/$defs/invalidResult"
    }
  ],
  "$defs": {
    "errorCode": {
      "enum": [
        "E_JSON_TYPE",
        "E_SCHEMA_VALIDATION",
        "E_IDENTITY_FIELD_FORBIDDEN",
        "E_GEOMETRY_SOURCE_IN_INTENT",
        "E_UNIT_UNSUPPORTED",
        "E_UNIT_DIMENSION_MISMATCH",
        "E_QUANTIFIER_COUNT_CONFLICT",
        "E_REFERENCE_FRAME_REQUIRED",
        "E_REFERENCE_FRAME_UNEXPECTED",
        "E_PRESSURE_DIRECTION_INVALID",
        "E_ROLE_UNKNOWN",
        "E_ROLE_OPERATION_INCOMPATIBLE",
        "E_ASSUMPTION_UNCONFIRMED",
        "E_OPERATION_ID_DUPLICATE",
        "E_DISPLACEMENT_DOF_DUPLICATE",
        "E_FILTER_RANGE_INVALID",
        "E_MISSING_INFORMATION",
        "E_AMBIGUOUS_REQUIREMENT",
        "E_UNSUPPORTED_ANALYSIS",
        "E_UNSUPPORTED_OPERATION",
        "E_INVALID_ENUM",
        "E_NONVALID_RESULT_HAS_INTENT"
      ]
    },
    "missingInformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "field_path",
        "description"
      ],
      "properties": {
        "code": {
          "enum": [
            "M_TARGET",
            "M_FEATURE_TYPE",
            "M_FACE_ROLE",
            "M_QUANTIFIER",
            "M_COUNT",
            "M_MAGNITUDE",
            "M_UNIT",
            "M_DIRECTION",
            "M_DISPLACEMENT_COMPONENT",
            "M_MATERIAL_NAME",
            "M_MATERIAL_PROPERTY",
            "M_MESH_SIZE",
            "M_REFERENCE"
          ]
        },
        "field_path": {
          "type": "string",
          "pattern": "^/"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "field_path",
        "description",
        "options"
      ],
      "properties": {
        "code": {
          "enum": [
            "A_FEATURE_TYPE",
            "A_FACE_ROLE",
            "A_TARGET_INSTANCE",
            "A_DIRECTION_ORIENTATION",
            "A_UNIT",
            "A_MATERIAL",
            "A_SPATIAL_REFERENCE"
          ]
        },
        "field_path": {
          "type": "string",
          "pattern": "^/"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "clarificationQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "field_path",
        "question"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "field_path": {
          "type": "string",
          "pattern": "^/"
        },
        "question": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "intent"
      ],
      "properties": {
        "schema_version": {
          "const": "cae-intent-result/1.0.0"
        },
        "status": {
          "const": "VALID"
        },
        "intent": {
          "$ref": "cae_intent.schema.json"
        }
      }
    },
    "clarificationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "error_code",
        "field_path",
        "missing_information",
        "ambiguities",
        "clarification_questions"
      ],
      "properties": {
        "schema_version": {
          "const": "cae-intent-result/1.0.0"
        },
        "status": {
          "const": "NEEDS_CLARIFICATION"
        },
        "error_code": {
          "enum": [
            "E_MISSING_INFORMATION",
            "E_AMBIGUOUS_REQUIREMENT"
          ]
        },
        "field_path": {
          "type": "string",
          "pattern": "^/"
        },
        "missing_information": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/missingInformation"
          }
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ambiguity"
          }
        },
        "clarification_questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/clarificationQuestion"
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "missing_information": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "ambiguities": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "invalidResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "error_code",
        "field_path",
        "missing_information",
        "ambiguities",
        "clarification_questions"
      ],
      "properties": {
        "schema_version": {
          "const": "cae-intent-result/1.0.0"
        },
        "status": {
          "const": "INVALID"
        },
        "error_code": {
          "$ref": "#/$defs/errorCode"
        },
        "field_path": {
          "type": "string",
          "pattern": "^/"
        },
        "missing_information": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/missingInformation"
          }
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ambiguity"
          }
        },
        "clarification_questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clarificationQuestion"
          }
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": "cae-intent-result/1.0.0",
      "status": "VALID",
      "intent": {
        "analysis_type": "static_structural",
        "assumptions": [],
        "normalization_audit": [],
        "operations": [
          {
            "operation_id": "feature_op",
            "operation_type": "fixed_support",
            "parameters": {
              "constrained_dofs": [
                "U1",
                "U2",
                "U3"
              ]
            },
            "target": {
              "face_role": "feature_region",
              "feature_type": "through_hole_round",
              "filters": {},
              "quantifier": "all"
            }
          }
        ],
        "schema_version": "cae-intent/1.0.0",
        "source_language": "zh-CN",
        "unit_system": {
          "angle": "deg",
          "area": "mm2",
          "displacement": "mm",
          "force": "N",
          "length": "mm",
          "pressure": "MPa"
        }
      }
    },
    {
      "ambiguities": [],
      "clarification_questions": [
        {
          "field_path": "/operations/0/required_field",
          "question": "Please clarify: Required engineering input M_TARGET was not provided for case 1.",
          "question_id": "q1"
        }
      ],
      "error_code": "E_MISSING_INFORMATION",
      "field_path": "/operations/0/required_field",
      "missing_information": [
        {
          "code": "M_TARGET",
          "description": "Required engineering input M_TARGET was not provided for case 1.",
          "field_path": "/operations/0/required_field"
        }
      ],
      "schema_version": "cae-intent-result/1.0.0",
      "status": "NEEDS_CLARIFICATION"
    }
  ]
}
