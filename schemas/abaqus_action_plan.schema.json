{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Abaqus Action Plan",
  "type": "object",
  "required": [
    "reasoning",
    "simulation_name",
    "model_name",
    "part_name",
    "instance_name",
    "operations"
  ],
  "properties": {
    "reasoning": { "type": "string" },
    "simulation_name": { "type": "string" },
    "model_name": { "type": "string" },
    "part_name": { "type": "string" },
    "instance_name": { "type": "string" },
    "source_mapping_path": { "type": ["string", "null"] },
    "available_regions": { "type": "object" },
    "selection_trace": { "type": "object" },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "material_name": { "type": "string" },
          "props": { "type": "object" },
          "global_size": { "type": "number" },
          "faces": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "local_size": { "type": "number" },
          "constraints": { "type": "object" },
          "load_type": { "type": "string" },
          "value": { "type": "number" }
        }
      }
    }
  }
}
