{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topocae.local/schemas/cae_query_ground_dataset_manifest.schema.json",
  "title": "TopoCAE CAE-QueryGround Dataset Manifest v1 Pilot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "status",
    "seed",
    "source",
    "counts",
    "files",
    "template_split_manifest",
    "review_gate",
    "scope_guards"
  ],
  "properties": {
    "schema_version": {"const": "cae-query-ground-dataset-manifest/1.0.0-h3.01-pilot"},
    "dataset_version": {"const": "cae-query-ground/1.0.0-h3.01-pilot"},
    "status": {"const": "pilot_waiting_h3_01"},
    "seed": {"type": "integer"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_root", "sample_manifest_sha256", "source_audit_sha256", "crosswalk_sha256", "p2_policy_sha256"],
      "properties": {
        "dataset_root": {"type": "string", "minLength": 1},
        "sample_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "source_audit_sha256": {"$ref": "#/$defs/sha256"},
        "crosswalk_sha256": {"$ref": "#/$defs/sha256"},
        "p2_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_records", "renderings", "splits", "languages", "levels", "statuses", "features", "operations"],
      "properties": {
        "canonical_records": {"type": "integer", "minimum": 800},
        "renderings": {"type": "integer", "minimum": 2400},
        "splits": {"$ref": "#/$defs/countMap"},
        "languages": {"$ref": "#/$defs/countMap"},
        "levels": {"$ref": "#/$defs/countMap"},
        "statuses": {"$ref": "#/$defs/countMap"},
        "features": {"$ref": "#/$defs/countMap"},
        "operations": {"$ref": "#/$defs/countMap"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "bytes", "sha256", "record_count"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/sha256"},
          "record_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "template_split_manifest": {"type": "string", "minLength": 1},
    "review_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "status", "required_rows", "reviewed_rows", "review_csv", "expression_csv"],
      "properties": {
        "gate": {"const": "H3-01"},
        "status": {"const": "WAITING_FOR_REAL_USER_REVIEW"},
        "required_rows": {"const": 120},
        "reviewed_rows": {"const": 0},
        "review_csv": {"type": "string", "minLength": 1},
        "expression_csv": {"type": "string", "minLength": 1}
      }
    },
    "scope_guards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["llm_called", "model_trained", "solver_executed", "holdout_run", "real_part_content_accessed", "formal_scale_generated", "p4_entered"],
      "properties": {
        "llm_called": {"const": false},
        "model_trained": {"const": false},
        "solver_executed": {"const": false},
        "holdout_run": {"const": false},
        "real_part_content_accessed": {"const": false},
        "formal_scale_generated": {"const": false},
        "p4_entered": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "countMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}
