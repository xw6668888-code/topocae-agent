{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAE Sample Manifest Record",
  "type": "object",
  "required": [
    "sample_id",
    "graph_path",
    "step_path",
    "node_count",
    "edge_count",
    "feature_set_count",
    "macro_feature_ids_present",
    "macro_features_present",
    "semantic_labels_present",
    "derived_macro_feature_ids_present",
    "derived_macro_features_present",
    "idealization_tag_ids_present",
    "idealization_tags_present",
    "has_nonstock"
  ],
  "properties": {
    "sample_id": { "type": "string" },
    "graph_path": { "type": "string" },
    "step_path": { "type": "string" },
    "node_count": { "type": "integer", "minimum": 0 },
    "edge_count": { "type": "integer", "minimum": 0 },
    "feature_set_count": { "type": "integer", "minimum": 0 },
    "macro_feature_ids_present": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "macro_features_present": {
      "type": "array",
      "items": { "type": "string" }
    },
    "semantic_labels_present": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "derived_macro_feature_ids_present": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "derived_macro_features_present": {
      "type": "array",
      "items": { "type": "string" }
    },
    "idealization_tag_ids_present": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "idealization_tags_present": {
      "type": "array",
      "items": { "type": "string" }
    },
    "has_nonstock": { "type": "boolean" }
  }
}
