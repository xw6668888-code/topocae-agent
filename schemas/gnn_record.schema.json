{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAE GNN Training Record",
  "type": "object",
  "required": [
    "sample_id",
    "source_graph_path",
    "source_step_path",
    "num_nodes",
    "num_edges",
    "edge_index",
    "edge_features",
    "edge_same_instance_labels",
    "edge_supervision_mask",
    "node_features",
    "primitive_surface_ids",
    "macro_feature_ids",
    "semantic_subtype_ids",
    "derived_macro_feature_ids_per_node",
    "idealization_tag_ids_per_node",
    "instance_ids",
    "feature_sets",
    "derived_label_summary"
  ],
  "properties": {
    "sample_id": { "type": "string" },
    "source_graph_path": { "type": "string" },
    "source_step_path": { "type": "string" },
    "num_nodes": { "type": "integer", "minimum": 0 },
    "num_edges": { "type": "integer", "minimum": 0 },
    "edge_index": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "integer" }
      }
    },
    "edge_features": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "number" }
      }
    },
    "edge_feature_schema": {
      "type": "array",
      "items": { "type": "string" }
    },
    "edge_same_instance_labels": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "edge_supervision_mask": {
      "type": "array",
      "items": { "type": "number" }
    },
    "node_features": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "number" }
      }
    },
    "primitive_surface_ids": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "macro_feature_ids": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "semantic_subtype_ids": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "derived_macro_feature_ids_per_node": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "integer" }
      }
    },
    "idealization_tag_ids_per_node": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "integer" }
      }
    },
    "instance_ids": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "feature_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["instance_id", "macro_feature", "macro_feature_id", "node_indices"],
        "properties": {
          "instance_id": { "type": "integer" },
          "macro_feature": { "type": "string" },
          "macro_feature_id": { "type": "integer" },
          "node_indices": {
            "type": "array",
            "items": { "type": "integer" }
          }
        }
      }
    },
    "derived_label_summary": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    }
  }
}
