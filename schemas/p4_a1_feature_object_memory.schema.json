{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topocae.local/schemas/p4_a1_feature_object_memory.schema.json",
  "title": "TopoCAE P4-A1 Oracle Feature-Object Memory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "memory_mode",
    "source_graph",
    "part",
    "objects",
    "memory_legality",
    "field_invariance"
  ],
  "properties": {
    "schema_version": {
      "const": "topocae-feature-object-memory/1.0.0"
    },
    "memory_mode": {
      "const": "oracle_geometry"
    },
    "source_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "sha256"],
      "properties": {
        "schema_version": {
          "const": "topocae_graph_v2_relative_1_1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_ref",
        "reference",
        "local_reference_frame",
        "face_index_contract"
      ],
      "properties": {
        "part_ref": {
          "type": "string",
          "pattern": "^part-[0-9a-f]{24}$"
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "point",
            "source",
            "coordinate_dependent"
          ],
          "properties": {
            "kind": {
              "enum": ["solid_centroid", "part_bbox_center"]
            },
            "point": {
              "$ref": "#/$defs/vector3"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "coordinate_dependent": {
              "const": true
            }
          }
        },
        "local_reference_frame": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "origin",
            "axes",
            "source",
            "rigid_rotation_covariant"
          ],
          "properties": {
            "kind": {
              "const": "graph_cartesian"
            },
            "origin": {
              "$ref": "#/$defs/vector3"
            },
            "axes": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/vector3"
              }
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "rigid_rotation_covariant": {
              "const": true
            }
          }
        },
        "face_index_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "base",
            "minimum",
            "maximum",
            "raw_step_face_ids_exposed"
          ],
          "properties": {
            "kind": {
              "const": "source_graph_node_index"
            },
            "base": {
              "const": 0
            },
            "minimum": {
              "const": 0
            },
            "maximum": {
              "type": "integer",
              "minimum": 0
            },
            "raw_step_face_ids_exposed": {
              "const": false
            }
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/featureObject"
      }
    },
    "memory_legality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "object_face_overlap_pairs",
        "source_face_count"
      ],
      "properties": {
        "status": {
          "enum": ["VALID", "INVALID"]
        },
        "object_face_overlap_pairs": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "source_face_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "field_invariance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rotation_invariant",
        "rigid_rotation_covariant",
        "coordinate_frame_dependent"
      ],
      "properties": {
        "rotation_invariant": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "rigid_rotation_covariant": {
          "$ref": "#/$defs/nonemptyStringArray"
        },
        "coordinate_frame_dependent": {
          "$ref": "#/$defs/nonemptyStringArray"
        }
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nullableNumber": {
      "type": ["number", "null"]
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "faceRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "face_role",
        "status",
        "selection_status",
        "semantic_subtype_candidates",
        "face_indices",
        "region_kind",
        "requires_complete_instance",
        "allowed_operations",
        "abstention_required",
        "reason"
      ],
      "properties": {
        "face_role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "status": {
          "enum": ["AVAILABLE", "UNAVAILABLE", "UNSUPPORTED"]
        },
        "selection_status": {
          "type": "string",
          "minLength": 1
        },
        "semantic_subtype_candidates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "face_indices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "region_kind": {
          "enum": ["feature_region", "face_set"]
        },
        "requires_complete_instance": {
          "type": "boolean"
        },
        "allowed_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "fixed_support",
              "displacement",
              "pressure",
              "surface_traction",
              "local_mesh_size"
            ]
          }
        },
        "abstention_required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "featureObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "canonical_feature_type",
        "feature_family",
        "semantic_face_roles",
        "face_role_map",
        "geometry_parameters",
        "descriptor_contract",
        "descriptors",
        "topology",
        "legality",
        "abstention"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "pattern": "^obj-[0-9]{4}$"
        },
        "canonical_feature_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "feature_family": {
          "type": "string",
          "minLength": 1
        },
        "semantic_face_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "face_role_map": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/faceRole"
          }
        },
        "geometry_parameters": {
          "type": "object"
        },
        "descriptor_contract": {
          "type": "object",
          "required": [
            "availability",
            "comparison_metric",
            "comparison_semantics",
            "scope",
            "is_complete_feature_description",
            "complete_dimension_keys"
          ],
          "properties": {
            "availability": {
              "enum": ["p3_oracle", "derived_legacy_singleton"]
            },
            "comparison_metric": {
              "$ref": "#/$defs/nullableString"
            },
            "comparison_semantics": {
              "$ref": "#/$defs/nullableString"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "is_complete_feature_description": {
              "type": "boolean"
            },
            "complete_dimension_keys": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "descriptors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "centroid",
            "area",
            "comparison_metric",
            "comparison_value",
            "comparison_semantics",
            "nearest_reference",
            "distance_to_part_reference"
          ],
          "properties": {
            "centroid": {
              "$ref": "#/$defs/vector3"
            },
            "area": {
              "type": "number",
              "minimum": 0
            },
            "comparison_metric": {
              "$ref": "#/$defs/nullableString"
            },
            "comparison_value": {
              "$ref": "#/$defs/nullableNumber"
            },
            "comparison_semantics": {
              "$ref": "#/$defs/nullableString"
            },
            "nearest_reference": {
              "type": "string",
              "minLength": 1
            },
            "distance_to_part_reference": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "topology": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_face_count",
            "object_face_count",
            "complete_instance_face_indices",
            "indices_are_zero_based",
            "node_labels_consistent"
          ],
          "properties": {
            "source_face_count": {
              "type": "integer",
              "minimum": 1
            },
            "object_face_count": {
              "type": "integer",
              "minimum": 1
            },
            "complete_instance_face_indices": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "indices_are_zero_based": {
              "const": true
            },
            "node_labels_consistent": {
              "const": true
            }
          }
        },
        "legality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "issues"],
          "properties": {
            "status": {
              "enum": ["VALID", "NEEDS_CLARIFICATION", "INVALID"]
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "abstention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "reasons",
            "explicit_role_restrictions"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "explicit_role_restrictions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
