{
  "$defs": {
    "executableGroundTruth": {
      "additionalProperties": false,
      "properties": {
        "contract_status": {
          "const": "executable"
        },
        "geometry_source": {
          "const": "oracle"
        },
        "intent_status": {
          "const": "VALID"
        },
        "targets": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/featureFaceTarget"
              },
              {
                "$ref": "#/$defs/wholePartTarget"
              }
            ]
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "contract_status",
        "intent_status",
        "geometry_source",
        "targets"
      ],
      "type": "object"
    },
    "featureFaceTarget": {
      "additionalProperties": false,
      "properties": {
        "canonical_feature_type": {
          "$ref": "#/$defs/featureType"
        },
        "face_role": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "grounding_required": {
          "const": true
        },
        "operation_id": {
          "$ref": "#/$defs/identifier"
        },
        "operation_type": {
          "enum": [
            "fixed_support",
            "displacement",
            "pressure",
            "surface_traction",
            "local_mesh_size"
          ]
        },
        "quantifier": {
          "enum": [
            "all",
            "exactly_one",
            "count",
            "largest",
            "smallest",
            "nearest"
          ]
        },
        "semantic_evidence": {
          "items": {
            "$ref": "#/$defs/semanticInstanceEvidence"
          },
          "minItems": 1,
          "type": "array"
        },
        "source_macro_features": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "target_contract": {
          "const": "feature_face_set"
        },
        "target_face_indices": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "target_instance_ids": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "uniqueness_contract": {
          "$ref": "#/$defs/uniquenessContract"
        }
      },
      "required": [
        "operation_id",
        "operation_type",
        "target_contract",
        "grounding_required",
        "canonical_feature_type",
        "source_macro_features",
        "face_role",
        "quantifier",
        "target_instance_ids",
        "target_face_indices",
        "semantic_evidence",
        "uniqueness_contract"
      ],
      "type": "object"
    },
    "featureType": {
      "enum": [
        "through_hole_round",
        "blind_hole_round",
        "stepped_hole_round",
        "counterbore_hole",
        "countersink_hole",
        "obround_hole",
        "slot_rect",
        "slot_u",
        "slot_v",
        "slot_o",
        "pocket_rect",
        "pocket_circular",
        "cylinder_boss",
        "rectangular_boss",
        "rib",
        "fillet",
        "chamfer"
      ]
    },
    "identifier": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "metricEvidence": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "enum": [
            "diameter",
            "radius",
            "depth",
            "area",
            "length",
            "width",
            "thickness",
            "distance"
          ]
        },
        "source": {
          "enum": [
            "feature_set.geometry_parameters",
            "node.attributes.physical",
            "graph_centroid_computation"
          ]
        },
        "stable_tolerance": {
          "minimum": 0,
          "type": "number"
        },
        "unit": {
          "enum": [
            "mm",
            "mm2"
          ]
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "metric",
        "value",
        "unit",
        "source",
        "stable_tolerance"
      ],
      "type": "object"
    },
    "nonExecutableGroundTruth": {
      "additionalProperties": false,
      "properties": {
        "contract_status": {
          "const": "non_executable"
        },
        "geometry_source": {
          "const": "oracle"
        },
        "intent_status": {
          "enum": [
            "NEEDS_CLARIFICATION",
            "INVALID"
          ]
        },
        "non_executable_reason": {
          "minLength": 1,
          "type": "string"
        },
        "targets": {
          "maxItems": 0,
          "type": "array"
        }
      },
      "required": [
        "contract_status",
        "intent_status",
        "geometry_source",
        "targets",
        "non_executable_reason"
      ],
      "type": "object"
    },
    "operationType": {
      "enum": [
        "fixed_support",
        "displacement",
        "pressure",
        "surface_traction",
        "material_assignment",
        "global_mesh_size",
        "local_mesh_size"
      ]
    },
    "query": {
      "additionalProperties": false,
      "properties": {
        "difficulty_level": {
          "enum": [
            "L1",
            "L2",
            "L3",
            "L4",
            "L5"
          ]
        },
        "language": {
          "enum": [
            "en-US",
            "zh-CN"
          ]
        },
        "rendering_id": {
          "$ref": "#/$defs/identifier"
        },
        "rendering_variant": {
          "enum": [
            "canonical",
            "en-1",
            "en-2",
            "zh-1"
          ]
        },
        "template_family_id": {
          "$ref": "#/$defs/identifier"
        },
        "template_id": {
          "$ref": "#/$defs/identifier"
        },
        "text": {
          "minLength": 5,
          "type": "string"
        }
      },
      "required": [
        "text",
        "language",
        "template_family_id",
        "template_id",
        "rendering_id",
        "rendering_variant",
        "difficulty_level"
      ],
      "type": "object"
    },
    "semanticInstanceEvidence": {
      "additionalProperties": false,
      "properties": {
        "instance_face_indices": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "instance_id": {
          "minimum": 1,
          "type": "integer"
        },
        "observed_semantic_roles": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "role_candidate_subtypes": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "selected_face_indices": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "source_macro_feature": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "instance_id",
        "source_macro_feature",
        "instance_face_indices",
        "selected_face_indices",
        "observed_semantic_roles",
        "role_candidate_subtypes"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "sourceRef": {
      "additionalProperties": false,
      "properties": {
        "base_geometry_family_id": {
          "minLength": 1,
          "type": "string"
        },
        "canonical_record_id": {
          "$ref": "#/$defs/identifier"
        },
        "canonical_semantics_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dataset_split": {
          "enum": [
            "train",
            "val",
            "test"
          ]
        },
        "derivation_kind": {
          "minLength": 1,
          "type": "string"
        },
        "exact_graph_signature": {
          "$ref": "#/$defs/sha256"
        },
        "geometry_format": {
          "enum": [
            "STEP",
            "OpenCASCADE_BREP_text"
          ]
        },
        "geometry_path": {
          "minLength": 1,
          "type": "string"
        },
        "graph_path": {
          "minLength": 1,
          "type": "string"
        },
        "graph_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "near_graph_signature": {
          "$ref": "#/$defs/sha256"
        },
        "sample_id": {
          "minLength": 1,
          "type": "string"
        },
        "source_split": {
          "enum": [
            "train",
            "val",
            "development_test"
          ]
        }
      },
      "required": [
        "canonical_record_id",
        "canonical_semantics_sha256",
        "sample_id",
        "graph_path",
        "graph_sha256",
        "geometry_path",
        "geometry_format",
        "base_geometry_family_id",
        "source_split",
        "dataset_split",
        "derivation_kind",
        "exact_graph_signature",
        "near_graph_signature"
      ],
      "type": "object"
    },
    "uniquenessContract": {
      "additionalProperties": false,
      "properties": {
        "candidate_count": {
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "enum": [
            "exactly_one",
            "all",
            "count",
            "attribute_filter",
            "comparison",
            "nearest"
          ]
        },
        "metric_evidence": {
          "items": {
            "$ref": "#/$defs/metricEvidence"
          },
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "type": "string"
        },
        "reference_frame": {
          "enum": [
            "global_cartesian",
            "part_local_cartesian"
          ]
        },
        "selected_count": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "candidate_count",
        "selected_count",
        "rationale"
      ],
      "type": "object"
    },
    "wholePartTarget": {
      "additionalProperties": false,
      "properties": {
        "grounding_required": {
          "const": false
        },
        "operation_id": {
          "$ref": "#/$defs/identifier"
        },
        "operation_type": {
          "enum": [
            "material_assignment",
            "global_mesh_size"
          ]
        },
        "scope": {
          "const": "whole_part"
        },
        "target_contract": {
          "const": "whole_part"
        }
      },
      "required": [
        "operation_id",
        "operation_type",
        "target_contract",
        "grounding_required",
        "scope"
      ],
      "type": "object"
    }
  },
  "$id": "https://topocae.local/schemas/cae_query_ground_record.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ground_truth": {
      "oneOf": [
        {
          "$ref": "#/$defs/executableGroundTruth"
        },
        {
          "$ref": "#/$defs/nonExecutableGroundTruth"
        }
      ]
    },
    "intent_result": {
      "$ref": "https://topocae.local/schemas/cae_intent_result.schema.json"
    },
    "query": {
      "$ref": "#/$defs/query"
    },
    "record_kind": {
      "enum": [
        "canonical",
        "rendering"
      ]
    },
    "record_schema_version": {
      "const": "cae-query-ground-record/1.0.0-h3.01"
    },
    "source_ref": {
      "$ref": "#/$defs/sourceRef"
    }
  },
  "required": [
    "record_schema_version",
    "record_kind",
    "source_ref",
    "query",
    "intent_result",
    "ground_truth"
  ],
  "title": "TopoCAE CAE-QueryGround Record v1 Frozen",
  "type": "object"
}
