{
  "$defs": {
    "countMap": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "minProperties": 1,
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://topocae.local/schemas/cae_query_ground_dataset_manifest.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "counts": {
      "additionalProperties": false,
      "properties": {
        "canonical_records": {
          "minimum": 20000,
          "type": "integer"
        },
        "features": {
          "$ref": "#/$defs/countMap"
        },
        "languages": {
          "$ref": "#/$defs/countMap"
        },
        "levels": {
          "$ref": "#/$defs/countMap"
        },
        "operations": {
          "$ref": "#/$defs/countMap"
        },
        "renderings": {
          "minimum": 60000,
          "type": "integer"
        },
        "splits": {
          "$ref": "#/$defs/countMap"
        },
        "statuses": {
          "$ref": "#/$defs/countMap"
        }
      },
      "required": [
        "canonical_records",
        "renderings",
        "splits",
        "languages",
        "levels",
        "statuses",
        "features",
        "operations"
      ],
      "type": "object"
    },
    "dataset_version": {
      "const": "cae-query-ground/1.0.0-h3.01"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "record_count": {
            "minimum": 0,
            "type": "integer"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "role",
          "path",
          "bytes",
          "sha256",
          "record_count"
        ],
        "type": "object"
      },
      "minItems": 6,
      "type": "array"
    },
    "review_gate": {
      "additionalProperties": false,
      "properties": {
        "expression_csv": {
          "minLength": 1,
          "type": "string"
        },
        "gate": {
          "const": "H3-01"
        },
        "required_rows": {
          "const": 120
        },
        "review_csv": {
          "minLength": 1,
          "type": "string"
        },
        "reviewed_rows": {
          "const": 120
        },
        "status": {
          "const": "PASS"
        }
      },
      "required": [
        "gate",
        "status",
        "required_rows",
        "reviewed_rows",
        "review_csv",
        "expression_csv"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "cae-query-ground-dataset-manifest/1.0.0-h3.01"
    },
    "scope_guards": {
      "additionalProperties": false,
      "properties": {
        "formal_scale_generated": {
          "const": true
        },
        "holdout_run": {
          "const": false
        },
        "llm_called": {
          "const": false
        },
        "model_trained": {
          "const": false
        },
        "p4_entered": {
          "const": false
        },
        "real_part_content_accessed": {
          "const": false
        },
        "solver_executed": {
          "const": false
        }
      },
      "required": [
        "llm_called",
        "model_trained",
        "solver_executed",
        "holdout_run",
        "real_part_content_accessed",
        "formal_scale_generated",
        "p4_entered"
      ],
      "type": "object"
    },
    "seed": {
      "type": "integer"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "crosswalk_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dataset_root": {
          "minLength": 1,
          "type": "string"
        },
        "p2_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sample_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_audit_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "dataset_root",
        "sample_manifest_sha256",
        "source_audit_sha256",
        "crosswalk_sha256",
        "p2_policy_sha256"
      ],
      "type": "object"
    },
    "status": {
      "const": "frozen"
    },
    "template_split_manifest": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "dataset_version",
    "status",
    "seed",
    "source",
    "counts",
    "files",
    "template_split_manifest",
    "review_gate",
    "scope_guards"
  ],
  "title": "TopoCAE CAE-QueryGround Dataset Manifest v1 Frozen",
  "type": "object"
}
