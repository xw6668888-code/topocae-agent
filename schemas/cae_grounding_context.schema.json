{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topocae.local/schemas/cae_grounding_context.schema.json",
  "title": "TopoCAE Grounding Context Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "geometry_source",
    "recognizer_capability_level",
    "coverage_status",
    "abstention_reasons",
    "feature_object_schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "cae-grounding-context/1.0.0"
    },
    "geometry_source": {
      "enum": [
        "oracle",
        "predicted",
        "human_confirmed"
      ]
    },
    "recognizer_capability_level": {
      "const": "LIMITED_CONTROLLED_DOMAIN"
    },
    "coverage_status": {
      "enum": [
        "ACCEPTED",
        "PARTIAL",
        "ABSTAIN",
        "ERROR"
      ]
    },
    "abstention_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "R_NO_ACCEPTED_OBJECT",
          "R_LOW_CONFIDENCE",
          "R_LOW_VALIDITY",
          "R_EMPTY_MEMBERSHIP",
          "R_TOPOLOGY_VETO",
          "R_GLOBAL_FACE_CONFLICT",
          "R_UNSUPPORTED_GRAPH_SCHEMA",
          "R_UNKNOWN_CAD_CONTEXT",
          "R_SLOT_PREDICTED_UNSUPPORTED",
          "R_RIB_WEB_PREDICTED_UNSUPPORTED",
          "R_POCKET_CIRCULAR_CAPABILITY_GAP",
          "R_TRANSITION_PREDICTED_LIMITED",
          "R_EXACT_FACE_SET_EVIDENCE_INSUFFICIENT",
          "R_HUMAN_CONFIRMATION_REQUIRED",
          "R_INFERENCE_ERROR"
        ]
      }
    },
    "feature_object_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "recognizer_name": {
      "type": "string",
      "minLength": 1
    },
    "context_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage_status": {
            "enum": [
              "ABSTAIN",
              "ERROR"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "abstention_reasons": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_status": {
            "const": "ACCEPTED"
          }
        }
      },
      "then": {
        "properties": {
          "abstention_reasons": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "geometry_source": {
            "const": "human_confirmed"
          }
        }
      },
      "then": {
        "properties": {
          "abstention_reasons": {
            "not": {
              "contains": {
                "const": "R_HUMAN_CONFIRMATION_REQUIRED"
              }
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "schema_version": "cae-grounding-context/1.0.0",
      "recognizer_capability_level": "LIMITED_CONTROLLED_DOMAIN",
      "feature_object_schema_version": "topocae_recognizer_dev_feature_objects_1",
      "geometry_source": "oracle",
      "coverage_status": "ACCEPTED",
      "abstention_reasons": []
    },
    {
      "schema_version": "cae-grounding-context/1.0.0",
      "recognizer_capability_level": "LIMITED_CONTROLLED_DOMAIN",
      "feature_object_schema_version": "topocae_recognizer_dev_feature_objects_1",
      "geometry_source": "predicted",
      "coverage_status": "ABSTAIN",
      "abstention_reasons": [
        "R_SLOT_PREDICTED_UNSUPPORTED"
      ]
    },
    {
      "schema_version": "cae-grounding-context/1.0.0",
      "recognizer_capability_level": "LIMITED_CONTROLLED_DOMAIN",
      "feature_object_schema_version": "topocae_recognizer_dev_feature_objects_1",
      "geometry_source": "human_confirmed",
      "coverage_status": "ACCEPTED",
      "abstention_reasons": []
    }
  ]
}
