{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topocae.local/schemas/cae_query_ground_record.schema.json",
  "title": "TopoCAE CAE-QueryGround Record v1 Pilot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_schema_version",
    "record_kind",
    "source_ref",
    "query",
    "intent_result",
    "ground_truth"
  ],
  "properties": {
    "record_schema_version": {
      "const": "cae-query-ground-record/1.0.0-h3.01-pilot"
    },
    "record_kind": {
      "enum": ["canonical", "rendering"]
    },
    "source_ref": {
      "$ref": "#/$defs/sourceRef"
    },
    "query": {
      "$ref": "#/$defs/query"
    },
    "intent_result": {
      "$ref": "https://topocae.local/schemas/cae_intent_result.schema.json"
    },
    "ground_truth": {
      "oneOf": [
        {"$ref": "#/$defs/executableGroundTruth"},
        {"$ref": "#/$defs/nonExecutableGroundTruth"}
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "featureType": {
      "enum": [
        "through_hole_round",
        "blind_hole_round",
        "stepped_hole_round",
        "counterbore_hole",
        "countersink_hole",
        "obround_hole",
        "slot_rect",
        "slot_u",
        "slot_v",
        "slot_o",
        "pocket_rect",
        "pocket_circular",
        "cylinder_boss",
        "rectangular_boss",
        "rib",
        "fillet",
        "chamfer"
      ]
    },
    "operationType": {
      "enum": [
        "fixed_support",
        "displacement",
        "pressure",
        "surface_traction",
        "material_assignment",
        "global_mesh_size",
        "local_mesh_size"
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_record_id",
        "canonical_semantics_sha256",
        "sample_id",
        "graph_path",
        "graph_sha256",
        "geometry_path",
        "geometry_format",
        "base_geometry_family_id",
        "source_split",
        "dataset_split",
        "derivation_kind",
        "exact_graph_signature",
        "near_graph_signature"
      ],
      "properties": {
        "canonical_record_id": {"$ref": "#/$defs/identifier"},
        "canonical_semantics_sha256": {"$ref": "#/$defs/sha256"},
        "sample_id": {"type": "string", "minLength": 1},
        "graph_path": {"type": "string", "minLength": 1},
        "graph_sha256": {"$ref": "#/$defs/sha256"},
        "geometry_path": {"type": "string", "minLength": 1},
        "geometry_format": {"enum": ["STEP", "OpenCASCADE_BREP_text"]},
        "base_geometry_family_id": {"type": "string", "minLength": 1},
        "source_split": {"enum": ["train", "val", "development_test"]},
        "dataset_split": {"enum": ["train", "val", "test"]},
        "derivation_kind": {"type": "string", "minLength": 1},
        "exact_graph_signature": {"$ref": "#/$defs/sha256"},
        "near_graph_signature": {"$ref": "#/$defs/sha256"}
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "language",
        "template_family_id",
        "template_id",
        "rendering_id",
        "rendering_variant",
        "difficulty_level"
      ],
      "properties": {
        "text": {"type": "string", "minLength": 5},
        "language": {"enum": ["en-US", "zh-CN"]},
        "template_family_id": {"$ref": "#/$defs/identifier"},
        "template_id": {"$ref": "#/$defs/identifier"},
        "rendering_id": {"$ref": "#/$defs/identifier"},
        "rendering_variant": {"enum": ["canonical", "en-1", "en-2", "zh-1"]},
        "difficulty_level": {"enum": ["L1", "L2", "L3", "L4", "L5"]}
      }
    },
    "semanticInstanceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "source_macro_feature",
        "instance_face_indices",
        "selected_face_indices",
        "observed_semantic_roles",
        "role_candidate_subtypes"
      ],
      "properties": {
        "instance_id": {"type": "integer", "minimum": 1},
        "source_macro_feature": {"type": "string", "minLength": 1},
        "instance_face_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "selected_face_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "observed_semantic_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "role_candidate_subtypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "metricEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "unit", "source", "stable_tolerance"],
      "properties": {
        "metric": {"enum": ["diameter", "radius", "depth", "area", "length", "width", "thickness", "distance"]},
        "value": {"type": "number"},
        "unit": {"enum": ["mm", "mm2"]},
        "source": {"enum": ["feature_set.geometry_parameters", "node.attributes.physical", "graph_centroid_computation"]},
        "stable_tolerance": {"type": "number", "minimum": 0}
      }
    },
    "uniquenessContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "candidate_count", "selected_count", "rationale"],
      "properties": {
        "kind": {"enum": ["exactly_one", "all", "count", "attribute_filter", "comparison", "nearest"]},
        "candidate_count": {"type": "integer", "minimum": 1},
        "selected_count": {"type": "integer", "minimum": 1},
        "rationale": {"type": "string", "minLength": 1},
        "metric_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/metricEvidence"}
        },
        "reference_frame": {"enum": ["global_cartesian", "part_local_cartesian"]}
      }
    },
    "featureFaceTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "operation_type",
        "target_contract",
        "grounding_required",
        "canonical_feature_type",
        "source_macro_features",
        "face_role",
        "quantifier",
        "target_instance_ids",
        "target_face_indices",
        "semantic_evidence",
        "uniqueness_contract"
      ],
      "properties": {
        "operation_id": {"$ref": "#/$defs/identifier"},
        "operation_type": {"enum": ["fixed_support", "displacement", "pressure", "surface_traction", "local_mesh_size"]},
        "target_contract": {"const": "feature_face_set"},
        "grounding_required": {"const": true},
        "canonical_feature_type": {"$ref": "#/$defs/featureType"},
        "source_macro_features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "face_role": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "quantifier": {"enum": ["all", "exactly_one", "count", "largest", "smallest", "nearest"]},
        "target_instance_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "target_face_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "semantic_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/semanticInstanceEvidence"}
        },
        "uniqueness_contract": {"$ref": "#/$defs/uniquenessContract"}
      }
    },
    "wholePartTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "operation_type", "target_contract", "grounding_required", "scope"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/identifier"},
        "operation_type": {"enum": ["material_assignment", "global_mesh_size"]},
        "target_contract": {"const": "whole_part"},
        "grounding_required": {"const": false},
        "scope": {"const": "whole_part"}
      }
    },
    "executableGroundTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_status", "intent_status", "geometry_source", "targets"],
      "properties": {
        "contract_status": {"const": "executable"},
        "intent_status": {"const": "VALID"},
        "geometry_source": {"const": "oracle"},
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/featureFaceTarget"},
              {"$ref": "#/$defs/wholePartTarget"}
            ]
          }
        }
      }
    },
    "nonExecutableGroundTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_status", "intent_status", "geometry_source", "targets", "non_executable_reason"],
      "properties": {
        "contract_status": {"const": "non_executable"},
        "intent_status": {"enum": ["NEEDS_CLARIFICATION", "INVALID"]},
        "geometry_source": {"const": "oracle"},
        "targets": {"type": "array", "maxItems": 0},
        "non_executable_reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
