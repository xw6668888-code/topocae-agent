{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAE Feature Object Output",
  "type": "object",
  "required": [
    "sample_id",
    "graph_mode",
    "source_step_path",
    "source_graph_path",
    "source_prediction_path",
    "fingerprint_schema",
    "feature_object_count",
    "stock_face_indices",
    "feature_objects"
  ],
  "properties": {
    "sample_id": { "type": "string" },
    "graph_mode": { "type": "string", "const": "feature_objects" },
    "source_step_path": { "type": ["string", "null"] },
    "source_graph_path": { "type": ["string", "null"] },
    "source_prediction_path": { "type": ["string", "null"] },
    "fingerprint_schema": {
      "type": "string",
      "const": "cae_feature_fingerprint_v1"
    },
    "feature_object_count": { "type": "integer", "minimum": 0 },
    "stock_face_indices": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "feature_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "feature_object_id",
          "grouping_method",
          "macro_feature_id",
          "macro_feature",
          "geometry_parameters",
          "face_indices",
          "face_count",
          "selectable_regions",
          "fingerprint"
        ],
        "properties": {
          "feature_object_id": { "type": "string" },
          "grouping_method": { "type": "string" },
          "macro_feature_id": { "type": "integer" },
          "macro_feature": { "type": "string" },
          "source_instance_id": { "type": ["integer", "null"] },
          "source_generator": { "type": ["string", "null"] },
          "geometry_parameters": {
            "type": "object"
          },
          "raw_parameters": {
            "type": "object"
          },
          "face_indices": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "face_count": { "type": "integer", "minimum": 1 },
          "selectable_regions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "role",
                "face_indices",
                "source_semantic_subtypes",
                "intended_uses",
                "is_default_for",
                "selection_priority"
              ],
              "properties": {
                "role": { "type": "string" },
                "face_indices": {
                  "type": "array",
                  "items": { "type": "integer" }
                },
                "source_semantic_subtypes": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "intended_uses": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "is_default_for": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "selection_priority": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "adjacent_stock_face_indices": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "adjacent_nonstock_face_indices": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "confidence": {
            "type": "object"
          },
          "fingerprint": {
            "$ref": "feature_fingerprint.schema.json"
          }
        }
      }
    }
  }
}
