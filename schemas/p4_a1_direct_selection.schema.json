{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topocae.local/schemas/p4_a1_direct_selection.schema.json",
  "title": "TopoCAE P4-A1 Direct LLM Selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "error_code", "message", "selections"],
  "properties": {
    "schema_version": {
      "const": "topocae-direct-selection/1.0.0"
    },
    "status": {
      "enum": ["VALID", "NEEDS_CLARIFICATION", "INVALID"]
    },
    "error_code": {
      "type": ["string", "null"]
    },
    "message": {
      "type": "string"
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selection_id",
          "operation_type",
          "selected_object_ids",
          "face_role"
        ],
        "properties": {
          "selection_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "operation_type": {
            "enum": [
              "material_assignment",
              "fixed_support",
              "displacement",
              "pressure",
              "surface_traction",
              "global_mesh_size",
              "local_mesh_size"
            ]
          },
          "selected_object_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^obj-[0-9]{4}$"
            }
          },
          "face_role": {
            "type": ["string", "null"]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "VALID"}
        }
      },
      "then": {
        "properties": {
          "error_code": {"type": "null"},
          "selections": {"minItems": 1}
        }
      },
      "else": {
        "properties": {
          "error_code": {"type": "string", "minLength": 1},
          "selections": {"maxItems": 0}
        }
      }
    }
  ]
}
