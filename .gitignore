# Local secret files must never be committed.
.env
.env.*
!.env.example

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local dependency folders
.venv/
venv/
env/
ENV/
.conda/

# IDE, editor, and OS noise
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# Codex/agent local scratch artifacts
.agents/
.claude/
.codex_pdfdeps/
.codex_pdf_text/
_literature_reading_tmp/
CODEX_CONTEXT.md
CODEX_CONTEXT_SUMMARY.md

# Generated experiment outputs and logs
output*
reports/
tmp*/
.tmp*/
*.log
*.tmp
*.orig
*.bak
*~

# Generated datasets, model checkpoints, and heavy binary artifacts
*.csv
*.tsv
*.xlsx
*.xls
*.npy
*.npz
*.pkl
*.joblib
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.hdf5

# CAD/CAE generated artifacts and archives
*.step
*.stp
*.iges
*.igs
*.sat
*.odb
*.prt
*.brep
*.zip
*.7z
*.rar

# Keep intentional documentation or small manifests tracked by default.
# If a generated file should be versioned, add it explicitly with:
#   git add -f path/to/file



