{
  "schema": "topocae_paper_v1_clean_evaluation_v1",
  "phase": "P1-A1",
  "object_match_iou": 0.5,
  "bootstrap": {
    "replicates": 2000,
    "confidence": 0.95,
    "seed": 20260716,
    "aggregation_unit": "part"
  },
  "threshold_selection": {
    "split": "synthetic_val",
    "grid_min": 0.5,
    "grid_max": 0.99,
    "grid_step": 0.01,
    "objective": "positive_class_f1",
    "tie_break": ["precision", "higher_threshold"]
  },
  "metrics": {
    "face": ["macro_accuracy", "macro_f1", "per_class_precision", "per_class_recall", "per_class_f1"],
    "semantic": ["macro_f1"],
    "edge": ["precision", "recall", "f1"],
    "object": ["precision", "recall", "f1", "exact_instance_ratio", "instance_iou"],
    "rotation": ["class_consistency", "object_correspondence_consistency", "face_role_consistency"],
    "unavailable": ["query_metrics"]
  },
  "clean_rib_selection": {
    "criterion_dataset": "synthetic_test",
    "rib_object_f1_requires_stable_gain": true,
    "macro_f1_max_drop": 0.005,
    "rotation_consistency_must_not_drop": true,
    "real_dev_used_for_selection": false
  },
  "repeatability": {
    "runs": 2,
    "prediction_comparison": "canonical JSON equality after removing output-location-only fields",
    "metric_comparison": "exact JSON equality"
  }
}
