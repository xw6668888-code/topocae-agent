{
  "schema_version": "topocae_cae_query_template_split_manifest_formal_1",
  "policy": "Formal train, val, and test use disjoint reviewed template families and sentence constructions.",
  "review_source": "reports/p3_a1_cae_queryground_v1/human_review_package/human_expression_adoption_decisions.csv",
  "splits": {
    "train": {
      "families": [
        "formal.train.canonical.engineering_request",
        "formal.train.en.preprocessing_setup",
        "formal.train.en.part_setup",
        "formal.train.zh.engineering_setup"
      ]
    },
    "val": {
      "families": [
        "formal.val.canonical.analysis_definition",
        "formal.val.en.model_configuration",
        "formal.val.en.required_preprocessing",
        "formal.val.zh.preprocessing_requirement"
      ]
    },
    "test": {
      "families": [
        "formal.test.canonical.cae_prescription",
        "formal.test.en.current_model_setup",
        "formal.test.en.execute_setup",
        "formal.test.zh.model_setup"
      ]
    }
  },
  "renderings_per_canonical": {"en-US": 2, "zh-CN": 1},
  "fixture_description_source_allowed": false,
  "llm_paraphrase_allowed": false
}
