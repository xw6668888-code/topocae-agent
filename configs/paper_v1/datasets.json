{
  "schema": "topocae_paper_dataset_policy_v1",
  "freeze_id": "paper_v1",
  "recognition_input_type": "inference_graph_json",
  "declared_splits": {
    "synthetic": [
      "Synthetic-Train",
      "Synthetic-Val",
      "Synthetic-Test"
    ],
    "real_dev_source_geometry": [
      "test_part",
      "test_part_s",
      "test_part_s1",
      "test_part_s2"
    ],
    "rotation_dev": "rotated derivatives of Real-Dev only",
    "real_holdout": "must be created after the recognizer freeze"
  },
  "excluded_artifacts": [
    {
      "path": "test_part_s3",
      "reason": "excluded research artifact; never a paper target, tuning source, or evaluation set"
    },
    {
      "path": "test_part_s3_rib_colored",
      "reason": "derived annotation artifact from the excluded s3 branch"
    }
  ],
  "deny_path_substrings": [
    "test_part_s3",
    "real_step_s3",
    "part_s3",
    "s3_rib_colored"
  ],
  "policy": {
    "paper_entry_must_reject_excluded_input": true,
    "paper_entry_must_reject_ancestor_of_excluded_input_when_recursive": true,
    "paper_entry_must_reject_excluded_output_path": true,
    "excluded_artifacts_may_only_be_cited_as_historical_technical_context": true
  }
}

