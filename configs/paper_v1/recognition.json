{
  "schema": "topocae_paper_recognition_config_v1",
  "freeze_id": "paper_v1",
  "phase": "P0-A1",
  "entrypoint": "run_paper_recognition_pipeline.py",
  "models": {
    "gnn_checkpoint": {
      "enabled": true,
      "path": "output_generation_v5_5_v51dist_looprole_5400/model_runs/edge_aware_v5_5_expanded_v51_compat_24dim/best.pt",
      "role": "edge-aware multi-task GNN with 24-dimensional loop-role edge schema",
      "selection": "historically recorded as the safest stable real-domain compatibility checkpoint"
    },
    "candidate_classifier": {
      "enabled": true,
      "path": "output_generation_v5_1_candidate_topology_dataset/model_runs/random_forest_v5_1_candidate_topology_hardw4/model.joblib",
      "role": "candidate topology classifier"
    },
    "instance_candidate_classifier": {
      "enabled": false,
      "path": null,
      "role": "same-instance assembled candidate classifier",
      "selection": "not frozen because v5.10 assembled grouping and v5.24 reason-aware classifier have recorded real-chain regressions"
    },
    "rib_candidate_proposer": {
      "enabled": true,
      "path": "output_generation_v5_9_b_rib_candidate_hardcase_dataset_predefinedfix_fulltrain/model_runs/random_forest_rib_candidate_proposer_v5_9_b_predefinedfix/model.joblib",
      "role": "rib face candidate proposer"
    },
    "rib_boundary_classifier": {
      "enabled": true,
      "path": "output_generation_v5_8_c_rib_boundary_colored_dataset/model_runs/random_forest_rib_boundary_colored_v5_8_c/model.joblib",
      "role": "rib boundary prune/expand classifier"
    }
  },
  "inference": {
    "device": "cpu",
    "recursive": true,
    "feature_round_ndigits": 6,
    "topology_postprocess": true,
    "same_instance_threshold": 0.5,
    "candidate_classifier_min_confidence": 0.5,
    "same_instance_assembly_threshold": 0.55,
    "same_instance_weak_threshold": 0.35,
    "instance_candidate_min_confidence": 0.5,
    "rib_candidate_proposer_min_confidence": 0.93,
    "rib_boundary_classifier_min_confidence": 0.75,
    "fingerprint_round_ndigits": 6,
    "feature_object_grouping": "connected_components_same_macro_feature",
    "pipeline_seed": 20260716,
    "pythonhashseed": 0
  },
  "label_schema_path": "configs/paper_v1/label_schema.json",
  "dataset_policy_path": "configs/paper_v1/datasets.json",
  "evaluation_config_path": "configs/paper_v1/evaluation.json",
  "freeze_manifest_path": "paper_v1_freeze_manifest.json",
  "security": {
    "credentials_required": false,
    "credential_source_if_future_service_is_enabled": "environment_variables_only",
    "dotenv_files_forbidden_in_repository": true
  }
}

